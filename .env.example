# App
DATABASE_URL=

# Acceso desde otra PC en la misma red (ejemplo):
# 1) En la PC del docente: npm run dev  +  docker compose up -d mediamtx
# 2) El estudiante abre http://IP_DEL_DOCENTE:3000  (no localhost)
# 3) En Firebase Console → Authentication → Settings → Authorized domains
#    agrega la IP del docente (ej. 192.168.2.10)
# 4) Si usas Google Login, en Google Cloud OAuth agrega:
#    http://IP_DEL_DOCENTE:3000 como origen de JavaScript autorizado

# MediaMTX / OBS streaming (en la PC del docente se queda en 127.0.0.1;
# el estudiante consume el vivo vía /api/hls del servidor del docente)
RTMP_PUBLIC_URL=rtmp://127.0.0.1:1935
HLS_PUBLIC_URL=http://127.0.0.1:8888
NEXT_PUBLIC_HLS_BASE_URL=http://127.0.0.1:8888
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RECORDINGS_DIR=./recordings

# OBS WebSocket (máquina del lab / host local)
OBS_URL=ws://127.0.0.1:4455
OBS_PORT=4455
OBS_PASSWORD=

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Supabase (grabaciones)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# UploadThing (fallback de grabaciones)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_TOKEN=
